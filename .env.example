# Copy this file to .env and fill in the values.
# .env is gitignored and never committed.

# ---------------------------------------------------------------------------
# Mollie payment gateway
# Get a test key at: https://my.mollie.com/dashboard/developers/api-keys
# ---------------------------------------------------------------------------
FUNDRAYS_MOLLIE_API_KEY=test_paste_your_key_here

# ---------------------------------------------------------------------------
# Optional overrides (defaults shown)
# ---------------------------------------------------------------------------
# Public base URL — used for absolute og:image and webhook URLs.
# Must end with a slash. Override when running behind a reverse proxy.
# FUNDRAYS_BASE_URL=http://localhost:8080/

# Enable Mollie in production (dev mode enables it automatically when the key is present).
# FUNDRAYS_MOLLIE_ENABLED=true
