# Copy this file to .env and fill in the values.
# .env is gitignored and never committed.

# ---------------------------------------------------------------------------
# Mollie payment gateway
# Get a test key at: https://my.mollie.com/dashboard/developers/api-keys
# ---------------------------------------------------------------------------
FUNDRAYS_MOLLIE_API_KEY=test_paste_your_key_here

# ---------------------------------------------------------------------------
# Optional overrides (defaults shown)
# ---------------------------------------------------------------------------
# Public base URL — used for absolute og:image and Mollie webhook URLs.
# Must end with a slash. Override when running behind a reverse proxy or
# a local tunnel (e.g. cloudflared tunnel --url http://localhost:8080).
# Without this, Mollie webhooks won't fire in dev mode (payments still work).
# FUNDRAYS_BASE_URL=https://your-tunnel-subdomain.trycloudflare.com/

# Enable Mollie in production (dev mode enables it automatically when the key is present).
# FUNDRAYS_MOLLIE_ENABLED=true
